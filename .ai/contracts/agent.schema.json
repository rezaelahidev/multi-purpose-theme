{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wordpress-theme-ai:agent:1",
  "type": "object",
  "required": [
    "contract_version",
    "agent"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "agent": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "type",
        "role",
        "mission",
        "responsibilities",
        "inputs",
        "outputs",
        "permissions",
        "quality",
        "handoff",
        "escalation"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "type": {
          "enum": [
            "coordinator",
            "specialist",
            "reviewer"
          ]
        },
        "role": {
          "type": "string"
        },
        "mission": {
          "type": "string"
        },
        "responsibilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inputs": {
          "type": "object",
          "required": [
            "required"
          ],
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "optional": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "outputs": {
          "type": "object",
          "required": [
            "required"
          ],
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "permissions": {
          "type": "object",
          "required": [
            "filesystem",
            "web",
            "terminal"
          ],
          "additionalProperties": false,
          "properties": {
            "filesystem": {
              "type": "object",
              "required": [
                "read",
                "write"
              ],
              "additionalProperties": false,
              "properties": {
                "read": {
                  "type": "boolean"
                },
                "write": {
                  "enum": [
                    "none",
                    "declared-output-paths-only",
                    "declared-state-files-only",
                    "task-file-scope-only",
                    "unrestricted"
                  ]
                }
              }
            },
            "web": {
              "type": "object",
              "required": [
                "access"
              ],
              "additionalProperties": false,
              "properties": {
                "access": {
                  "type": "boolean"
                }
              }
            },
            "terminal": {
              "type": "object",
              "required": [
                "access"
              ],
              "additionalProperties": false,
              "properties": {
                "access": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quality": {
          "type": "object",
          "required": [
            "criteria"
          ],
          "additionalProperties": false,
          "properties": {
            "criteria": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "handoff": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target": {
              "type": "string"
            },
            "approval_required": {
              "type": "boolean"
            }
          }
        },
        "escalation": {
          "type": "object",
          "required": [
            "conditions"
          ],
          "additionalProperties": false,
          "properties": {
            "conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}