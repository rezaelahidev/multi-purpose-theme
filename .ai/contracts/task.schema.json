{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wordpress-theme-ai:task:1",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "assigned_agent",
    "dependencies",
    "inputs",
    "expected_outputs",
    "acceptance_criteria",
    "file_scope",
    "approval"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "BACKLOG",
        "READY",
        "IN_PROGRESS",
        "REVIEW",
        "APPROVED",
        "COMPLETED",
        "BLOCKED",
        "REJECTED",
        "ON_HOLD",
        "FAILED",
        "CANCELLED"
      ]
    },
    "assigned_agent": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "file_scope": {
      "type": "object",
      "required": [
        "include",
        "exclude"
      ],
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "required": [
        "required",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "not-required",
            "pending",
            "approved",
            "rejected"
          ]
        }
      }
    }
  }
}